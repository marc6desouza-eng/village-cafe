# ==============================================================================
# VILLAGE CAFE — Environment Variables Configuration
# Copy this file to backend/.env or configure in your deployment platform
# ==============================================================================

# Server Port
PORT=5000

# Database Connection (MongoDB Atlas or local MongoDB)
# Note: If no MongoDB is connected, the app automatically runs in High-Reliability
# Persistent Local Store mode (backend/data/*.json) with full schema compliance.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/village_cafe?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_village_cafe_goa_curtorim_2026
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (Created automatically by npm run seed)
ADMIN_EMAIL=admin@villagecafe.goa
ADMIN_PASSWORD=VillageCafeGoa2026!

# Allowed Frontend Origins for CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Cloudinary Persistent Cloud Storage (Optional)
# If omitted, uploaded images persist automatically to the backend/uploads directory.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
